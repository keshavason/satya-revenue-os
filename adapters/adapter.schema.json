{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satya-revenue-os.local/schemas/adapter.schema.json",
  "title": "SATYA Revenue OS vertical adapter",
  "type": "object",
  "required": [
    "contractVersion", "id", "version", "name", "vertical", "economicUnit", "salesMotion",
    "lifecycleStates", "metricDefinitions", "constraints", "channels", "complianceNotes",
    "economicDefaults", "requiredEvidence", "unsupportedAssumptions", "planningProfile"
  ],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "vertical": {"enum": ["saas", "ecommerce", "professional-services", "local-business", "hospitality", "industrial-b2b"]},
    "economicUnit": {"type": "string", "minLength": 1},
    "salesMotion": {"type": "string", "minLength": 1},
    "lifecycleStates": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metricDefinitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "constraints": {"$ref": "#/$defs/nonEmptyStrings"},
    "channels": {"$ref": "#/$defs/nonEmptyStrings"},
    "complianceNotes": {"$ref": "#/$defs/nonEmptyStrings"},
    "economicDefaults": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/default"}},
    "requiredEvidence": {"$ref": "#/$defs/nonEmptyStrings"},
    "unsupportedAssumptions": {"$ref": "#/$defs/nonEmptyStrings"},
    "planningProfile": {
      "type": "object",
      "required": ["typicalSalesCycleDays", "primaryDecisionMetric"],
      "properties": {
        "typicalSalesCycleDays": {"type": "number", "minimum": 0},
        "primaryDecisionMetric": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "metric": {
      "type": "object",
      "required": ["id", "unit", "formula", "period", "grain"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1},
        "formula": {"type": "string", "minLength": 1}, "period": {"type": "string", "minLength": 1},
        "grain": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "default": {
      "type": "object",
      "required": ["name", "value", "unit", "evidence", "bounded", "asOf", "source"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "value": {"type": "number"}, "unit": {"type": "string", "minLength": 1},
        "evidence": {"const": "modelled"}, "bounded": {"const": true}, "asOf": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
