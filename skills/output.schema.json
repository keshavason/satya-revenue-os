{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SATYA skill result",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "status",
        "skill",
        "version",
        "artifact",
        "effects"
      ],
      "properties": {
        "status": {
          "const": "completed"
        },
        "skill": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "artifact": {
          "type": "object"
        },
        "effects": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    {
      "type": "object",
      "required": [
        "status",
        "skill",
        "version",
        "abstention",
        "effects"
      ],
      "properties": {
        "status": {
          "const": "abstained"
        },
        "skill": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "abstention": {
          "type": "object",
          "required": [
            "code",
            "reason",
            "missingEvidence",
            "contradictions"
          ]
        },
        "effects": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  ]
}

